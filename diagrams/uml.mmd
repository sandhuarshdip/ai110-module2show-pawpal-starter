classDiagram
    class Owner {
        +String ownerName
        +String preference
        +addPet()
    }

    class Pet {
        +String petName
        +String petBreed
    }

    class Task {
        +String taskName
        +int timeToComplete
        +String priority
        +createTask()
    }

    class Schedule {
        +createSchedule()
    }

    Owner "1" --> "0..*" Pet : has
    Pet "1" --> "0..*" Task : has care tasks
    Schedule "1" --> "0..*" Task : includes
    Owner "1" --> "0..*" Schedule : receives plans
