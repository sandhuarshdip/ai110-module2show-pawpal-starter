classDiagram
    class Owner {
        +String ownerName
        +String preference
        +addPet()
        +getAllTasks()
        +filterTasks(completed, petName)
        +createSchedule()
    }

    class Pet {
        +String petName
        +String petBreed
        +addTask(task)
    }

    class Task {
        +String description
        +int timeToComplete
        +String priority
        +bool daily
        +Date dueDate
        +Time scheduledTime
        +bool completed
        +Pet pet
        +createTask()
        +markComplete()
        +markIncomplete()
    }

    class Schedule {
        +Map~Date, List~Task~~ tasksByDate
        +createSchedule(owner)
        +getConflictWarnings()
    }

    Owner "1" --> "0..*" Pet : has
    Pet "1" --> "0..*" Task : has care tasks
    Task "0..*" --> "1" Pet : belongs to
    Schedule "1" --> "0..*" Task : lists by due date
    Owner "1" --> "0..*" Schedule : receives plans
    Schedule ..> Owner : retrieves all pet tasks
